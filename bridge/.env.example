# Default listener is local-only. Use 0.0.0.0 for an intentionally exposed LAN listener.
WS_HOST=127.0.0.1
WS_PORT=8765
# An HTTPS headset page requires WSS. Use locally generated trusted certificates
# or a TLS proxy; never commit private keys.
# WS_TLS_CERT=/absolute/path/to/lan.pem
# WS_TLS_KEY=/absolute/path/to/lan-key.pem

# Set your own arm's port and calibration ID before --hardware.
FOLLOWER_PORT=
FOLLOWER_ID=so101_follower
TARGET_HZ=15
INPUT_TIMEOUT_S=0.25
MAX_JOINT_DELTA_DEG=5
EE_STEP_SIZE=1
EE_MAX_STEP_M=0.08
XR_ROT_SCALE=0
XR_ROT_DEADBAND=0.05
XR_POS_DEADBAND=0.005
