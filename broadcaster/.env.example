TRACK_NAME=robot-camera
CAMERA_SOURCE=0
WEBCAM_WIDTH=1280
WEBCAM_HEIGHT=720
# Start with a generated pattern; set false for an explicitly selected camera.
USE_TEST_PATTERN=true
