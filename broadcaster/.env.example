CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_TOKEN=
# HTTPS address of the operator application reachable from the headset.
VIEWER_URL=https://localhost:3000
# Optional: leave blank for video-only operation.
BRIDGE_URL=
